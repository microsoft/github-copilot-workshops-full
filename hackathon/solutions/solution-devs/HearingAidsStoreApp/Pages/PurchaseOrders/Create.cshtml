@page
@model HearingAidsStoreApp.Pages.PurchaseOrders.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>PurchaseOrder</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PurchaseOrder.CustomerId" class="control-label"></label>
                <select asp-for="PurchaseOrder.CustomerId" class="form-control" asp-items="ViewBag.CustomerId"></select>
                <span asp-validation-for="PurchaseOrder.CustomerId" class="text-danger"></span>
            </div
             <div class="form-group">
                <label asp-for="PurchaseOrder.ProductId" class="control-label"></label>
                <select asp-for="PurchaseOrder.ProductId" class="form-control" asp-items="ViewBag.ProductId"></select>
                <span asp-validation-for="PurchaseOrder.ProductId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PurchaseOrder.PurchaseDate" class="control-label"></label>
                <input asp-for="PurchaseOrder.PurchaseDate" class="form-control" />
                <span asp-validation-for="PurchaseOrder.PurchaseDate" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
