@page
@model HearingAidsStoreApp.Pages.PurchaseOrders.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>PurchaseOrder</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.PurchaseDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrder.PurchaseDate)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.Customer)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrder.Customer.FullName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.Product)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrder.Product.Name)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="PurchaseOrder.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
